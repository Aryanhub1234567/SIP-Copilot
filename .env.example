# PostgreSQL connection string (Neon/Supabase/local PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Auth.js / Google OAuth. Register http://localhost:3000/api/auth/callback/google as a redirect URI.
AUTH_SECRET="generate-a-random-secret-with-npx-auth-secret"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# Optional Gemini explanation. When omitted, the API returns a deterministic explanation.
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_FALLBACK_MODEL="gemini-3.5-flash"
